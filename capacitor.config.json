{
  "appId": "br.com.treinohg.app",
  "appName": "Grow Up",
  "webDir": "www",
  "android": {
    "backgroundColor": "#0A0A0A",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#C8FF1A"
    },
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "css"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}